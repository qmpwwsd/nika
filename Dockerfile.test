# Linux checks for nika. Official images only, pinned by digest. The container gets a copy of the repo and nothing else:
# never mount your home folder or ~/.claude into it.
#
#   verify (default)  docker build -f Dockerfile.test -t nika-verify . && docker run --rm nika-verify
#   gui smoke (heavy) docker build -f Dockerfile.test --target gui -t nika-gui . && docker run --rm -e NIKA_SMOKE_NO_SANDBOX=1 nika-gui
#
# `verify` runs scripts/linux-verify.sh. `gui` compiles the Tauri shell and runs scripts/gui-smoke.sh under Xvfb; the
# WebKit sandbox needs user namespaces, which a default container does not have, hence NIKA_SMOKE_NO_SANDBOX (never set
# it in CI). The last stage is the default target.

FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS nodebase

FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS gui
# Tauri v2 Linux prerequisites (same list as .github/workflows/ci.yml), plus Xvfb and a session bus for the smoke test.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev \
      librsvg2-dev xvfb xauth dbus-x11 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=nodebase /usr/local/bin/node /usr/local/bin/node
WORKDIR /srv/nika
COPY . .
RUN cargo build --locked --manifest-path app/src-tauri/Cargo.toml
CMD ["bash", "scripts/gui-smoke.sh"]

FROM nodebase AS verify
RUN apt-get update && apt-get install -y --no-install-recommends tmux procps iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o node -g node /srv/nika
USER node
WORKDIR /srv/nika
COPY --chown=node:node . .
CMD ["bash", "scripts/linux-verify.sh"]
